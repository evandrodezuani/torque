# Preencha os valores antes de subir
# Uso: copie para .env (copy .env.example .env) e rode docker compose up --build.
# O .env não vai para o Git; este arquivo vai, por isso nunca coloque aqui uma senha usada de verdade.

# Banco da aplicação: o PostgreSQL do compose é criado com este usuário e esta senha,
# e a aplicação usa os mesmos para se conectar
DB_USER=
DB_PASSWORD=

# Assina os tokens do login; precisa ter pelo menos 32 caracteres, senão a aplicação não sobe
JWT_SECRET=

# Primeiro ADMIN, criado na subida se não houver nenhum ADMIN ativo; é o login do POST /auth/login
TORQUE_ADMIN_EMAIL=
TORQUE_ADMIN_SENHA=

# Senha dos usuários de demonstração (gerente, atendente, mecanico e almoxarife @torque.local),
# recriados a cada subida; vazia, eles não são criados
TORQUE_DEMO_SENHA=

# Perfil ci: usuário e senha do banco "sonar", criado na primeira subida do PostgreSQL
SONAR_DB_USER=
SONAR_DB_PASSWORD=

# Perfil ci: fica vazio na primeira subida. Depois de entrar no SonarQube, gere o token em
# My Account > Security e cole aqui (começa com squ_). O Jenkins usa este token para enviar a análise
SONAR_TOKEN=

# Perfil ci: login da tela do Jenkins (http://localhost:8090)
JENKINS_ADMIN_USER=
JENKINS_ADMIN_SENHA=
